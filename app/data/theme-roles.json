{
  "groups": [
    {
      "id": "surfaces",
      "label": "Surfaces & lines",
      "roles": [
        {
          "name": "canvas",
          "path": "colors.canvas",
          "description": "Main background behind content: tables, editor, terminal (--background). Seed of the derived palette."
        },
        {
          "name": "surface",
          "path": "colors.surface",
          "description": "Panels and cards: side panel, grouped settings (--surface-2 / --card)."
        },
        {
          "name": "surfaceRaised",
          "path": "colors.surfaceRaised",
          "description": "Raised surfaces; the placeholder text is checked against it."
        },
        {
          "name": "surfaceOverlay",
          "path": "colors.surfaceOverlay",
          "description": "Popovers, menus, dialogs, command palette and editor widgets (--surface-3 / --popover)."
        },
        {
          "name": "border",
          "path": "colors.border",
          "description": "Hairline borders (--border); --border-subtle and --border-strong are mixed from it."
        },
        {
          "name": "input",
          "path": "colors.input",
          "description": "Input borders (--input)."
        },
        {
          "name": "focus",
          "path": "colors.focus",
          "description": "Focus rings (--ring) and the editor's focus border."
        },
        {
          "name": "codeBackground",
          "path": "colors.codeBackground",
          "description": "Inline code background."
        },
        {
          "name": "codeForeground",
          "path": "colors.codeForeground",
          "description": "Inline code text."
        }
      ]
    },
    {
      "id": "text",
      "label": "Text",
      "roles": [
        {
          "name": "text",
          "path": "colors.text",
          "description": "Primary text (--foreground). Kept at 7:1 contrast on the canvas."
        },
        {
          "name": "textMuted",
          "path": "colors.textMuted",
          "description": "Secondary text (T3 Code). JET Pilot's muted text is `mutedForeground`."
        },
        {
          "name": "muted",
          "path": "colors.muted",
          "description": "Muted backgrounds: skeletons, subtle fills (--muted)."
        },
        {
          "name": "mutedForeground",
          "path": "colors.mutedForeground",
          "description": "Muted text: descriptions, captions, table meta (--muted-foreground)."
        },
        {
          "name": "placeholder",
          "path": "colors.placeholder",
          "description": "Input placeholder text."
        },
        {
          "name": "secondaryLabel",
          "path": "colors.secondaryLabel",
          "description": "Secondary labels (T3 Code)."
        },
        {
          "name": "iconMuted",
          "path": "colors.iconMuted",
          "description": "Muted icons (T3 Code)."
